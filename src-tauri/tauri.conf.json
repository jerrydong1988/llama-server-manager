{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LlamaServerManager",
  "version": "2.9.44",
  "identifier": "com.llama.manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://modelscope.cn https://www.modelscope.cn https://huggingface.co; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi", "dmg", "deb"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNjI2Nzc2REVGNDJBRTgKUldUb0t2VGVkbWRpR3NpVC9PazJjUCsyVXVnL3htSFI2VHZBcHRDbm90YWRvTmgxcVlCYUJENEMK",
      "endpoints": [
        "https://updates.cnzone.net/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
